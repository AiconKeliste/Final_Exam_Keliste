global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
	static_configs:
	- targets: ['localhost:{{ prometheus.port }}']

  - job_name: node
	static_configs:
	- targets:
{% for h in groups['web_servers'] %}
        - '{{ hostvars[h].ansible_host }}:{{ node_exporter.port }}'
{% endfor %}
